{
  "name": "deep-press",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.8.2",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "lint": "node scripts/check-boundaries.mjs",
    "contracts:check": "vitest run tests/contracts",
    "ownership": "node scripts/check-ownership.mjs",
    "bootstrap:check": "node scripts/check-bootstrap.mjs",
    "check": "npm run bootstrap:check && npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/three": "0.186.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
